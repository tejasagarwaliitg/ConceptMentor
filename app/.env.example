# Copy to .env.local (never commit .env.local)
# AI mode is OFF unless ALL of these are set. The public app works fully without them (no-AI mode).
ACCESS_CODE=
CLINE_API_KEY=
MENTOR_MODEL=
CLINE_BASE_URL=https://api.cline.bot/api/v1
ITEM_SECRET=
SERVE_UNAPPROVED=false
# Telegram reminders (WP-A/C): all placeholder until demo. Missing token = bot
# endpoints honestly report "not_configured"; the app still works fully.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
# Minimal reminder store (chat bindings + due timestamps only). Unset = in-memory
# single-instance store for local dev; set for any deployment with >1 instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=
NOTIFY_CRON_SECRET=
# Set true ONLY if MENTOR_MODEL accepts images (e.g. anthropic/claude-sonnet-4-6). Lets the agent read the uploaded photo.
MENTOR_VISION=false
